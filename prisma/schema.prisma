generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  CASHIER
  STAFF
}

enum MedicineItemType {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  DROPS
  OINTMENT
  EQUIPMENT
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  email          String               @unique
  name           String
  passwordHash   String
  status         UserStatus           @default(ACTIVE)
  roleId         String               @db.ObjectId
  lastLoginAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  role           Role                 @relation(fields: [roleId], references: [id])
  sessions       Session[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]
  stockLedgers   StockLedger[]

  @@index([roleId])
  @@index([status])
}

model Role {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        RoleName         @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  permissionId String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash  String   @unique
  userId     String   @db.ObjectId
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String    @db.ObjectId
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PharmacySettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique @default("singleton")
  pharmacyName      String
  address           String?
  mobile            String?
  email             String?
  gstin             String?
  logoUrl           String?
  invoicePrefix     String   @default("INV")
  currency          String   @default("INR")
  lowStockThreshold Int      @default(10)
  expiryWarningDays Int      @default(30)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  userId    String?  @db.ObjectId
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Category {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  medicines   Medicine[]
}

model Manufacturer {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String     @unique
  contact   String?
  email     String?
  address   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  medicines Medicine[]
}

model Medicine {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  genericName        String?
  composition        String?
  categoryId         String?        @db.ObjectId
  manufacturerId     String?        @db.ObjectId
  dosageForm         String?
  itemType          MedicineItemType @default(TABLET)
  strength           String?
  packSize           String?
  unit               String
  hsnCode            String?
  gstPercentage      Float          @default(0)
  prescriptionRequired Boolean      @default(false)
  barcode            String?        @unique
  sku                String         @unique
  mrp                Float          @default(0)
  purchasePrice      Float          @default(0)
  sellingPrice       Float          @default(0)
  minimumStock       Int            @default(0)
  active             Boolean        @default(true)
  category           Category?      @relation(fields: [categoryId], references: [id])
  manufacturer       Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  batches            Batch[]
  purchaseItems      PurchaseItem[]
  stockLedgers       StockLedger[]
  saleItems          SaleItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([name])
  @@index([genericName])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([active])
}

model Batch {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  medicineId      String        @db.ObjectId
  batchNumber     String
  manufacturingDate DateTime
  expiryDate      DateTime
  purchasePrice   Float
  mrp             Float
  sellingPrice    Float
  quantity        Int           @default(0)
  freeQuantity    Int           @default(0)
  medicine        Medicine      @relation(fields: [medicineId], references: [id])
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  stockLedgers    StockLedger[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([quantity])
}

model StockLedger {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  medicineId       String    @db.ObjectId
  batchId          String    @db.ObjectId
  previousQuantity Int
  quantityChange   Int
  newQuantity      Int
  reason           String
  reference        String?
  userId           String?   @db.ObjectId
  createdAt        DateTime  @default(now())
  medicine         Medicine  @relation(fields: [medicineId], references: [id])
  batch            Batch     @relation(fields: [batchId], references: [id])
  user             User?     @relation(fields: [userId], references: [id])

  @@index([medicineId, createdAt])
  @@index([batchId, createdAt])
  @@index([createdAt])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK
  CREDIT
}

enum PurchaseStatus {
  COMPLETED
  CANCELLED
}

model Supplier {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  businessName    String
  contactPerson   String?
  mobile          String?
  email           String?
  address         String?
  gstin           String?
  paymentTerms    String?
  openingBalance  Float          @default(0)
  outstandingBalance Float       @default(0)
  status          SupplierStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  purchases       Purchase[]
  payments        SupplierPayment[]

  @@index([businessName])
  @@index([status])
}

model Purchase {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  supplierId      String?         @db.ObjectId
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  subtotal        Float
  discount        Float           @default(0)
  taxableAmount   Float
  cgst            Float           @default(0)
  sgst            Float           @default(0)
  igst            Float           @default(0)
  roundOff        Float           @default(0)
  grandTotal      Float
  paidAmount      Float           @default(0)
  balanceAmount   Float           @default(0)
  status          PurchaseStatus  @default(COMPLETED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]
  payments        SupplierPayment[]

  @@unique([supplierId, invoiceNumber])
  @@index([invoiceDate])
  @@index([supplierId, invoiceDate])
  @@index([status])
}

model PurchaseItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId     String   @db.ObjectId
  medicineId     String   @db.ObjectId
  batchId        String   @db.ObjectId
  expiryDate     DateTime
  quantity       Int
  freeQuantity   Int      @default(0)
  purchaseRate   Float
  mrp            Float
  sellingPrice   Float
  discount       Float    @default(0)
  gstPercentage  Float    @default(0)
  lineTotal      Float
  purchase       Purchase @relation(fields: [purchaseId], references: [id])
  medicine       Medicine @relation(fields: [medicineId], references: [id])
  batch          Batch    @relation(fields: [batchId], references: [id])

  @@index([purchaseId])
  @@index([medicineId])
  @@index([batchId])
}

model SupplierPayment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  supplierId    String        @db.ObjectId
  purchaseId    String?       @db.ObjectId
  amount        Float
  method        PaymentMethod
  reference     String?
  note          String?
  createdAt     DateTime      @default(now())
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id])

  @@index([supplierId, createdAt])
  @@index([purchaseId])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Customer {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  mobile             String?
  email              String?
  address            String?
  openingBalance     Float              @default(0)
  outstandingBalance Float              @default(0)
  status             CustomerStatus     @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sales              Sale[]
  payments           CustomerPayment[]
  @@index([name])
  @@index([mobile])
  @@index([status])
}

model Sale {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String?            @db.ObjectId
  invoiceNumber String             @unique
  invoiceDate   DateTime           @default(now())
  subtotal      Float
  discount      Float              @default(0)
  grandTotal    Float
  paidAmount    Float              @default(0)
  balanceAmount Float              @default(0)
  costAmount    Float              @default(0)
  status        SaleStatus         @default(COMPLETED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  customer      Customer?          @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  payments      CustomerPayment[]
  @@index([invoiceDate])
  @@index([customerId, invoiceDate])
}

model SaleItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  saleId       String   @db.ObjectId
  medicineId   String   @db.ObjectId
  batchId      String   @db.ObjectId
  quantity     Int
  sellingPrice Float
  costPrice    Float
  discount     Float    @default(0)
  lineTotal    Float
  sale         Sale     @relation(fields: [saleId], references: [id])
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  batch        Batch    @relation(fields: [batchId], references: [id])
  @@index([saleId])
  @@index([medicineId])
}

model CustomerPayment {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  customerId String        @db.ObjectId
  saleId     String?       @db.ObjectId
  amount     Float
  method     PaymentMethod
  reference  String?
  createdAt  DateTime      @default(now())
  customer   Customer      @relation(fields: [customerId], references: [id])
  sale       Sale?         @relation(fields: [saleId], references: [id])
  @@index([customerId, createdAt])
}
