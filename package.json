{
  "name": "pharma-desc",
  "version": "1.0.1",
  "private": true,
  "description": "Pharma Desc desktop application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "start": "electron .",
    "desktop": "concurrently --kill-others-on-fail \"next dev -p 3000\" \"wait-on http://localhost:3000 && set ELECTRON_START_URL=http://localhost:3000&& electron .\"",
    "start:web": "next start",
    "clean": "node scripts/clean-desktop.js",
    "build": "npm run dist",
    "build:next": "npm run prisma:generate && next build --webpack && npm run verify:next-standalone",
    "build:web": "npm run build:next",
    "prepare:desktop": "node scripts/prepare-desktop.js",
    "verify:next-standalone": "node scripts/verify-next-standalone.js",
    "verify:desktop:staged": "node scripts/verify-desktop.js staged",
    "verify:desktop": "node scripts/verify-desktop.js package",
    "dist": "npm run clean && npm run icons && npm run build:next && npm run prepare:desktop && npm run verify:desktop:staged && electron-builder --win nsis --publish never && npm run verify:desktop",
    "publish-release": "npm run clean && npm run icons && npm run build:next && npm run prepare:desktop && npm run verify:desktop:staged && electron-builder --win nsis --publish always && npm run verify:desktop",
    "lint": "eslint .",
    "desktop:build": "npm run build:next",
    "desktop:dist": "npm run dist",
    "dist:publish": "npm run publish-release",
    "desktop:release": "npm run publish-release",
    "icons": "node scripts/generate-icons.js",
    "prisma:clean": "node -e \"const fs=require('fs'); const path=require('path'); const dir=path.join(process.cwd(),'node_modules','.prisma','client'); if (!fs.existsSync(dir)) process.exit(0); for (const entry of fs.readdirSync(dir)) { const full = path.join(dir, entry); if (entry.startsWith('query_engine-windows.dll.node.tmp') || entry.endsWith('.tmp') || entry.endsWith('.tmp.lock')) { try { fs.rmSync(full, {force: true}); console.log('Removed stale Prisma temp file:', entry); } catch (error) { console.warn('Could not remove stale Prisma temp file:', entry, error.message); } } }\"",
    "prisma:generate": "npm run prisma:clean && prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.16.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.544.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "wait-on": "^9.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "mongodb": "^7.6.0",
    "png-to-ico": "^3.0.2",
    "prisma": "6.16.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.pharmadesk.app",
    "productName": "PharmaDesk",
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "public/**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/coverage/**",
      "!**/docs/**",
      "!**/.git/**",
      "!**/.github/**",
      "!**/.vscode/**",
      "!**/.DS_Store"
    ],
    "extraResources": [
      {
        "from": "desktop-app",
        "to": "app",
        "filter": ["**/*", "**/.*", "!node_modules{,/**/*}"]
      },
      {
        "from": "desktop-app/node_modules",
        "to": "app/node_modules",
        "filter": ["**/*", "**/.*"]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "artifactName": "PharmaDesk Setup.${ext}",
      "executableName": "PharmaDesk"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "shortcutName": "PharmaDesk",
      "uninstallDisplayName": "PharmaDesk",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nageshpatidar02-coder",
        "repo": "pharmacy-management",
        "releaseType": "release"
      }
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}